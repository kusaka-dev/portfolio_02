<!DOCTYPE html>
<html lang="ja">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title><%= pageTitle %></title><!-- ページタイトルを入力 -->
  <meta name="description" content="<%= description %>"><!-- ページの説明を入力 -->
  <meta property="og:type" content="website"><!-- OGPタイプ（website, article など） -->
  <meta property="og:title" content="<%= pageTitle %>"><!-- OGPタイトル（ページタイトルと同じ） -->
  <meta property="og:description" content="<%= ogpDescription %>"><!-- OGP用の説明を入力 -->
  <meta property="og:image" content="<%= ogpimg %>"><!-- OGP画像のURLを入力 -->
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="<%= pageUrl %>"><!-- ページのURLを入力 -->
  <meta property="og:site_name" content="サイト名"><!-- サイト名を入力 -->
  <meta property="og:locale" content="ja_JP">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@username"><!-- Twitterアカウントを入力 -->
  <meta name="twitter:creator" content="@username"><!-- Twitterアカウントを入力 -->
  <meta name="keywords" content="<%= keywords %>"><!-- キーワードを入力（カンマ区切り） -->
  <meta name="format-detection" content="telephone=no">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <!-- ファビコン -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <!-- スタイルシート -->
  <link type="text/css" rel="stylesheet" href="/assets/styles/style.scss">
  <!-- JavaScript -->
  <script type="module" src="/assets/scripts/main.js"></script>
  <!-- フォント -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet">
</head>

<body>
  <header class="header">
    <div class="header__inner">
      <div class="header__logo">
        <a href="/">
          <img src="/assets/images/logo.svg" alt="サイトロゴ">
        </a>
      </div>
      <nav class="header__nav">
        <ul class="header__nav-list">
          <li class="header__nav-item"><a href="/">ホーム</a></li>
          <li class="header__nav-item"><a href="/about.html">このサイトについて</a></li>
          <li class="header__nav-item"><a href="/service.html">サービス</a></li>
          <li class="header__nav-item"><a href="/contact.html">お問い合わせ</a></li>
        </ul>
      </nav>
      <button class="header__toggle" type="button" aria-label="メニュー" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>
