        </div>

        <!-- PC用ナビゲーション -->
        <nav class="l-header__nav-pc">
          <ul>
            <li class="l-header__nav-item--has-dropdown">
              <a href="#service">Service +</a>
            </li>
            <li><a href="#cases">Cases</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#news">News</a></li>
          </ul>
        </nav>

        <!-- PC用CTAボタン -->
        <a href="#contact" class="l-header__cta-pc">無料相談を予約</a>

        <!-- SP用ハンバーガーボタン -->
        <button
          class="l-header__toggle"
          type="button"
          aria-expanded="false"
          aria-label="メニューを開く"
        >
          <span class="l-header__toggle-bar"></span>
          <span class="l-header__toggle-bar"></span>
        </button>
      </div>
    </header>

    <!-- SP用ナビゲーション -->
    <nav class="l-header__nav-sp">
      <ul>
        <li><a href="#service">Service</a></li>
        <li><a href="#cases">Cases</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#news">News</a></li>
      </ul>
      <a href="#contact" class="l-header__cta-sp">無料相談を予約</a>
    </nav>

    <!-- サービスドロップダウンメニュー（PC用） -->
    <div class="p-service-menu">
      <div class="p-service-menu__inner">
        <div class="p-service-menu__image">
          <div
            class="p-service-menu__image-item p-service-menu__image-item--active"
            data-service="business-strategy"
          >
            <!-- Business Strategy 画像 -->
          </div>
          <div class="p-service-menu__image-item" data-service="hr-development">
            <!-- HR Development 画像 -->
          </div>
          <div class="p-service-menu__image-item" data-service="dx-support">
            <!-- DX Support 画像 -->
          </div>
        </div>
        <ul class="p-service-menu__list">
          <li>
            <a
              href="#service-business-strategy"
              class="p-service-menu__item"
              data-service="business-strategy"
            >
              <p class="p-service-menu__subtitle">Business Strategy</p>
              <h4 class="p-service-menu__heading">経営戦略コンサルティング</h4>
              <p class="p-service-menu__description">
                企業の成長を支える戦略立案から実行支援まで。市場分析や競合調査を通じて実現可能な成長戦略を策定します。
              </p>
            </a>
          </li>
          <li>
            <a
              href="#service-hr-development"
              class="p-service-menu__item"
              data-service="hr-development"
            >
              <p class="p-service-menu__subtitle">HR Development</p>
              <h4 class="p-service-menu__heading">組織・人材開発</h4>
              <p class="p-service-menu__description">
                組織の成長を支える人材育成と組織体制の最適化。人事制度設計から研修プログラムまで総合的に支援します。
              </p>
            </a>
          </li>
          <li>
            <a
              href="#service-dx-support"
              class="p-service-menu__item p-service-menu__item--last"
              data-service="dx-support"
            >
              <p class="p-service-menu__subtitle">DX Support</p>
              <h4 class="p-service-menu__heading">DX推進支援</h4>
              <p class="p-service-menu__description">
                デジタル技術を活用した業務変革とビジネスモデルの革新。DX戦略の策定から実装まで伴走型で支援します。
              </p>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </body>
</html>
